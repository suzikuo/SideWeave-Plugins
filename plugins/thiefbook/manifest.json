{
  "manifestVersion": 1,
  "apiVersion": 1,
  "id": "thiefbook",
  "name": "书架",
  "icon": "ui/icon.svg",
  "version": "1.0.17",
  "description": "TXT reading shelf with floating reader and progress tracking",
  "author": "SideWeave",
  "type": "native",
  "publisher": "sideweave",
  "key_id": "main-2026-rotation-1",
  "requires_trust": true,
  "runtime": "dynamic_library",
  "backend": "plugin.dll",
  "autoStart": true,
  "capabilities": [
    "storage",
    "filesystem.read",
    "filesystem.external_read",
    "window.create",
    "window.manage",
    "shortcut.global",
    "system.file_picker"
  ],
  "ui": {
    "entry": "ui/index.html",
    "kind": "vue",
    "assetRoot": "ui",
    "initialWidth": 820,
    "initialHeight": 820
  },
  "hoverPreview": {
    "width": 280,
    "height": 180,
    "dataMethod": "get_preview"
  }
}
