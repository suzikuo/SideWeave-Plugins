{
  "manifestVersion": 1,
  "apiVersion": 1,
  "id": "notification-lab",
  "name": "Notification Lab",
  "icon": "ui/icon.svg",
  "version": "0.1.0",
  "description": "Test Windows, host desktop, and sidebar notifications",
  "author": "Agile Tiles",
  "runtime": "dynamic_library",
  "backend": "plugin.dll",
  "trust": "trusted_local",
  "autoStart": false,
  "permissions": ["notification.system", "notification.desktop", "notification.sidebar"],
  "ui": {
    "entry": "ui/index.html",
    "kind": "vue",
    "assetRoot": "ui",
    "initialWidth": 620,
    "initialHeight": 800,
    "minWidth": 520,
    "minHeight": 640
  }
}
