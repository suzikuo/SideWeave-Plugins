{
  "manifestVersion": 1,
  "apiVersion": 1,
  "id": "cloudflare_tunnel",
  "name": "Cloudflare Tunnel",
  "icon": "ui/icon.svg",
  "version": "1.0.22",
  "description": "SideWeave 本地 Cloudflare Tunnel 快速管理器",
  "author": "SideWeave",
  "type": "native",
  "publisher": "sideweave",
  "key_id": "main-2026-rotation-1",
  "requires_trust": true,
  "runtime": "dynamic_library",
  "backend": "plugin.dll",
  "autoStart": false,
  "capabilities": [
    "storage",
    "filesystem.read",
    "filesystem.write",
    "filesystem.external_read",
    "system.file_picker",
    "process.spawn",
    "system.open_external",
    "network.connect",
    "clipboard"
  ],
  "requiredCapabilities": [
    "filesystem.write"
  ],
  "ui": {
    "entry": "ui/index.html",
    "kind": "vue",
    "assetRoot": "ui",
    "initialWidth": 840,
    "initialHeight": 780
  },
  "hoverPreview": {
    "width": 280,
    "height": 180,
    "dataMethod": "get_preview"
  }
}