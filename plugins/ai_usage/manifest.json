{
  "manifestVersion": 1,
  "apiVersion": 1,
  "id": "ai_usage",
  "name": "AI 用量",
  "icon": "ui/icon.svg",
  "version": "0.4.14",
  "description": "汇总本机 AI 编程工具的 Token、估算费用、会话和订阅配额。",
  "author": "SideWeave",
  "type": "native",
  "publisher": "sideweave",
  "key_id": "main-2026-rotation-1",
  "requires_trust": true,
  "runtime": "dynamic_library",
  "backend": "plugin.dll",
  "autoStart": true,
  "capabilities": [
    "filesystem.read",
    "filesystem.write",
    "network.connect",
    "notification.desktop"
  ],
  "ui": {
    "entry": "ui/index.html",
    "kind": "vue",
    "assetRoot": "ui",
    "initialWidth": 1040,
    "initialHeight": 780
  },
  "hoverPreview": {
    "width": 360,
    "height": 260,
    "entry": "ui/preview.html"
  }
}