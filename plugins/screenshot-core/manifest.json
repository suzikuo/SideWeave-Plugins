{
  "manifestVersion": 1,
  "apiVersion": 1,
  "id": "screenshot",
  "name": "快捷截图",
  "icon": "ui/icon.svg",
  "version": "0.4.0",
  "description": "SnowAir 风格全能桌面截图套件：区域截图与丰富标注、可自定义双色工具栏、滚动长截图、区域录屏实时标注、离线 OCR 与多引擎图片翻译、智能贴图、演示白板及拼图/PDF·PPT 合并",
  "author": "SideWeave",
  "type": "native",
  "publisher": "sideweave",
  "key_id": "main-2026-rotation-1",
  "requires_trust": true,
  "runtime": "external_process",
  "backend": "sideweave_screenshot-core.exe",
  "autoStart": true,
  "capabilities": [
    "filesystem.write",
    "shortcut.global",
    "clipboard",
    "network.connect",
    "storage"
  ],
  "ui": {
    "entry": "ui/index.html",
    "kind": "vue",
    "assetRoot": "ui",
    "chrome": "plugin",
    "initialWidth": 980,
    "initialHeight": 680,
    "minWidth": 760,
    "minHeight": 560
  }
}
